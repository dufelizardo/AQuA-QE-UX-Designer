 id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="g_n3" target="g_n4a" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="g_n3" target="g_n4b" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="g_n4a" target="g_n5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="g_n4b" target="g_n5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="g_n5" target="g_b2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="refinamento" name="4 - Ciclo de refinamento humano-no-loop com memoria RAG"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r_n1" value="review_notes preenchido&#xa;(checklist ou revisor reprovou)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="380.0" y="40.0" width="340.0" height="60.0" as="geometry"/></mxCell><mxCell id="r_n2" value="generate_ux_clarifying_questions&#xa;(LLM gerador transforma review_notes em perguntas)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="380.0" y="140.0" width="340.0" height="60.0" as="geometry"/></mxCell><mxCell id="r_n3" value="Para cada pergunta:&#xa;suggest_refinement_answer busca no Qdrant&#xa;(embedding bge-m3) a resposta mais similar ja dada" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="380.0" y="240.0" width="340.0" height="70.0" as="geometry"/></mxCell><mxCell id="r_b1" value="Sugestao so exibida (emoji + score&#xa;de similaridade) -- nunca aplicada&#xa;automaticamente. Sem gate de score&#xa;minimo, sem filtro por artefato." style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="800.0" y="245.0" width="280.0" height="90.0" as="geometry"/></mxCell><mxCell id="r_n4" value="Humano digita a resposta final&#xa;(input() no terminal, run.py)" style="ellipse;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="380.0" y="350.0" width="340.0" height="60.0" as="geometry"/></mxCell><mxCell id="r_n5" value="record_refinement_answer&#xa;(grava pergunta+resposta no Qdrant, memoria institucional)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="380.0" y="450.0" width="340.0" height="60.0" as="geometry"/></mxCell><mxCell id="r_n6" value="refine_ux_specification&#xa;(reescreve so os campos que as respostas abordam)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="380.0" y="550.0" width="340.0" height="60.0" as="geometry"/></mxCell><mxCell id="r_n7" value="finalize_ux_specification&#xa;(revalida: validate -&gt; review -&gt; synthesize_recommendations)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="380.0" y="650.0" width="340.0" height="60.0" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="r_n1" target="r_n2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="r_n2" target="r_n3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="r_n3" target="r_b1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="r_n3" target="r_n4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="r_n4" target="r_n5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="r_n5" target="r_n6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="r_n6" target="r_n7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="handoff" name="5 - Pipeline completo e handoff (Product Manager + Product Owner -> UX Designer -> UI Designer)"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p_n1" value="AQuA-QE Product Manager&#xa;PRD aceito (Personas, Jornadas do Usuario)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40.0" y="60.0" width="280.0" height="70.0" as="geometry"/></mxCell><mxCell id="p_n2" value="AQuA-QE Product Owner&#xa;Story/Epic aceita (Jira)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40.0" y="160.0" width="280.0" height="60.0" as="geometry"/></mxCell><mxCell id="p_n3" value="AQuA-QE UX Designer&#xa;UX Specification&#xa;(User Flows, IA, Acessibilidade, Recomendacoes)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="400.0" y="100.0" width="300.0" height="90.0" as="geometry"/></mxCell><mxCell id="p_n4" value="AQuA-QE UI Designer&#xa;(futuro sibling, ainda nao iniciado)&#xa;Wireframes, Prototipos, Design System" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="760.0" y="100.0" width="280.0" height="90.0" as="geometry"/></mxCell><mxCell id="p_n5" value="Confluence Cloud&#xa;(pagina irma do PRD de origem)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="400.0" y="260.0" width="300.0" height="60.0" as="geometry"/></mxCell><mxCell id="p_b1" value="Secoes 8/9/11 (Wireframes/&#xa;Prototipos/Design System) ficam&#xa;vazias/fora de escopo ate o UI&#xa;Designer ser implementado --&#xa;primeira integracao nao-textual&#xa;(Figma) da plataforma" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="760.0" y="260.0" width="280.0" height="100.0" as="geometry"/></mxCell><mxCell id="e1" value="entrada (Confluence)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="p_n1" target="p_n3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="entrada (Jira)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="p_n2" target="p_n3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="preenche secoes 8/9/11 quando existir" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="p_n3" target="p_n4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="opcional, gated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="p_n3" target="p_n5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="p_n4" target="p_b1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphMod