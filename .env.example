# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env   (ou: Copy-Item .env.example .env no PowerShell)

# Ollama (local) — único provedor de LLM nesta fase (sem piloto de provedor em nuvem,
# ver docs/agent/system_design.md).
# Instale o Ollama (https://ollama.com) e baixe os dois modelos usados por este agente:
#   ollama pull mistral   # geração (OLLAMA_MODEL)
#   ollama pull phi4      # revisão independente (OLLAMA_REVIEW_MODEL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_REVIEW_MODEL=phi4

# Jira Cloud — obrigatório apenas para usar --jira (apenas leitura, este agente nunca escreve no Jira)
# Token gerado em id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://seu-site.atlassian.net/
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence Cloud — obrigatório apenas para usar --confluence / --publicar-confluence
# Usa as mesmas credenciais do Jira (JIRA_EMAIL / JIRA_API_TOKEN) acima.
# Sem CONFLUENCE_SPACE_KEY: o espaço/página-mãe de publicação é sempre derivado da página
# de origem do PRD (get_confluence_publish_location), nunca de configuração manual —
# mesmo padrão do Solution Architect.
